# Copie para `.env` e preencha. O `.env` real fica fora do Git.
#
# Carregado por:
#   - artifacts/api-server (via `node --env-file-if-exists`)
#   - lib/db/drizzle.config.ts (via `process.loadEnvFile`)

# Postgres. Em desenvolvimento costuma ser um banco Neon.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Porta do servidor de API. O app móvel assume 8080 ao derivar o endereço
# da API a partir do host do Metro (artifacts/barber-app/src/lib/env.ts).
PORT=8080

NODE_ENV=development

# Assina os cookies de sessão da web E os tokens Bearer do app.
# Trocar este valor desloga todo mundo nas duas superfícies.
# Em produção é obrigatório: o servidor se recusa a subir sem ele.
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Opcionais — cada um desliga uma funcionalidade se ausente.

# Checkout do Mercado Pago. Sem ele as rotas de pagamento falham.
# MERCADOPAGO_ACCESS_TOKEN=

# Domínio público usado no retorno do pagamento. Sem ele o callback
# aponta para um endereço inválido fora do Replit.
# APP_URL=

# Painel de super admin. Sem os dois, /admin/login responde 503.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
